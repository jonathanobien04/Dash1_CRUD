@model EntprogCRUD.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<h1>Delete Customer</h1>

<h3>Are you sure you want to delete this customer?</h3>

<div>
    <p><strong>Customer Name:</strong> @Model.CustomerName</p>
    <p><strong>Contact Name:</strong> @Model.ContactName</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Phone:</strong> @Model.Phone</p>
    <p><strong>Address:</strong> @Model.Address</p>
    <p><strong>City:</strong> @Model.City</p>
    <p><strong>State:</strong> @Model.State</p>
    <p><strong>Zip Code:</strong> @Model.ZipCode</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="CustomerId" />

    <button type="submit">Delete</button>

    <a asp-action="Index">Cancel</a>
</form>